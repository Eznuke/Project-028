# ===== REQUIRED =====
# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord Developer Portal -> your app -> General Information -> Application ID
CLIENT_ID=

# ===== RECOMMENDED =====
# Your own Discord user ID (comma-separate several). Enables /owner commands.
OWNER_ID=
# Test server ID. Used by `npm run deploy:guild` (commands appear instantly there).
GUILD_ID=
# Invite link to your support server (shown by /support)
SUPPORT_SERVER_URL=

# ===== OPTIONAL: GENERAL =====
DB_PATH=data/bot.db
LOG_LEVEL=info
DEFAULT_COLOR=5865F2
DEFAULT_TIMEZONE=UTC
# Chat prefix for text commands like !help (1-5 characters, no spaces). Servers can change it with /config prefix.
DEFAULT_PREFIX=!
# Global per-user rate limit: max commands per window
GLOBAL_RATE_MAX=6
GLOBAL_RATE_WINDOW_SEC=10

# ===== OPTIONAL: AI CHAT (any OpenAI-compatible chat-completions API) =====
AI_ENABLED=false
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_SYSTEM_PROMPT=You are a friendly, concise assistant inside a Discord server. Keep answers under 1500 characters.
AI_COOLDOWN_SECONDS=10
AI_HOURLY_LIMIT=30
AI_MAX_INPUT_CHARS=1000

# ===== OPTIONAL: /translate =====
# mymemory (no key needed, small daily quota) or libretranslate (self-hosted / keyed)
TRANSLATE_PROVIDER=mymemory
TRANSLATE_API_URL=
TRANSLATE_API_KEY=

# ===== OPTIONAL: /shorten =====
# Leave SHORTENER_URL_TEMPLATE empty to disable /shorten. {url} is replaced with the encoded URL.
# The response body must be the short URL as plain text. Example (is.gd):
SHORTENER_URL_TEMPLATE=https://is.gd/create.php?format=simple&url={url}

# ===== OPTIONAL: MUSIC (experimental, needs extra packages + ffmpeg, see README) =====
MUSIC_ENABLED=false
